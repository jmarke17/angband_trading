# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cython debug symbols
cython_debug/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
.tox/
.nox/
*.cover
coverage.xml
*.cover

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment / virtualenv
.env/
.venv/
env/
venv/
ENV/
.envrc

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Data: raw or processed data that’s regenerated or too pesado para versionar
data/raw/
data/processed/
data/cache/

# Notebooks outputs (si produces outputs separados)
*.nbconvert.*
output/
reports/

# Config files with secretos / credenciales (que no deben estar versionados)
secrets.yaml
*.key
*.pem

# Misc
__pypackages__/    # si usas PEP 582
